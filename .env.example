# ───────── Website + admin (used at build time) ─────────
# Website + admin use THIS server's /api automatically. Don't put the old server address here.
# (Only for a frontend hosted without the server next to it.)
VITE_API_URL=
VITE_BACKEND_URL=
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.gutargooproo.application
VITE_APP_STORE_URL=

# ───────── Server ─────────
PORT=3001
# MongoDB connection string
MONGO_URI=
# Long random text used to sign login tokens (keep secret; changing it logs everyone out)
JWT_SECRET=
# App users stay logged in this many days (default 180)
CUSTOMER_TOKEN_DAYS=180
# Proxies in front of Node: 1 = Cloud Run direct or nginx (default); 2 = Cloudflare/load balancer + that; 0 = none
TRUST_PROXY=1

# Bunny Stream (videos)
BUNNY_VIDEO_API_KEY=
BUNNY_LIBRARY_ID=
# Bunny Stream CDN hostname, e.g. vz-xxxxxxxx-xxx.b-cdn.net (Bunny → Stream → your library → API).
# Needed so the website can play videos through this server (/stream).
BUNNY_CDN_HOSTNAME=
# Public address for videos. On the live server: https://admin.gutargooplus.com/stream
BUNNY_STREAM_PUBLIC_BASE=https://admin.gutargooplus.com/stream
# App downloads (MP4): khali = BUNNY_STREAM_PUBLIC_BASE se (jo networks b-cdn.net block karte hain unpe bhi chale);
# lekin Cloud Run agar khud hi wahi address serve kar raha ho to seedha BUNNY_CDN_HOSTNAME se.
# Force karna ho to: DOWNLOAD_VIA=cdn (hamesha Bunny CDN) ya DOWNLOAD_VIA=proxy (hamesha BUNNY_STREAM_PUBLIC_BASE)
DOWNLOAD_VIA=

# Bunny Storage (images)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
# Only if your storage zone is not in the default (Falkenstein) region, e.g. sg.storage.bunnycdn.com
BUNNY_STORAGE_HOST=storage.bunnycdn.com
# Public address for images. On the live server: https://admin.gutargooplus.com/storage
BUNNY_STORAGE_PUBLIC_BASE=https://admin.gutargooplus.com/storage

# SMS (OTP)
SMS_USER=
SMS_AUTH_KEY=
SMS_SENDER=
SMS_TEMPLATE_ID=
SMS_BASE_URL=https://web.smscloud.in/api/pushsms

# Optional: a test login for App Store / Play Store reviewers (no SMS sent). Leave empty to disable.
OTP_TEST_MOBILE=
OTP_TEST_CODE=

# ── Pehla admin bina terminal ke (AI Studio / Cloud Run) ──
# Dono bharo → server ek baar restart → /admin pe isi email/password se login → phir dono HATA do.
# Ye admin sirf tab banta hai jab ye email pehle se na ho. Existing admin ka password nahi badalta.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Password bhool gaye? ADMIN_RESET_PASSWORD=yes bhi daalo → ek restart → password reset (purane logins logout).
# (Password already wahi hai to kuch reset nahi hota — har restart pe logout nahi hoga.)
# Uske baad teeno (ADMIN_EMAIL, ADMIN_PASSWORD, ADMIN_RESET_PASSWORD) HATA do.
ADMIN_RESET_PASSWORD=

# Cloud Scheduler ke liye: POST /api/bunny/sync header "x-sync-key: <SYNC_KEY>" → processing videos ka status update.
# Khali chhodo to ye endpoint band rahega.
SYNC_KEY=
